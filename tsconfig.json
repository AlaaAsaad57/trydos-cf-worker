{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["packages/**/*.ts", "workers/**/*.ts"]
}
