{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trydos-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Bound to the SAME hostname the app serves from — the auth cookies are
  // host-only, so a sibling subdomain would not receive MARKET-TOKEN.
  //
  // CUT OVER 2026-08-24. /api/proxy is now served by this Worker; the Next
  // route of the same name still exists but is shadowed and no longer
  // reachable on this hostname.
  //
  // ROLLBACK: delete the /api/proxy route in the Cloudflare dashboard
  // (Workers & Pages → trydos-proxy → Settings → Domains & Routes), or remove
  // it here and redeploy. Traffic falls straight back to the Next route with
  // no deploy of trydos needed. Seconds, not minutes.
  //
  // /api/proxy-edge is kept so the Worker stays reachable under a stable name
  // for testing after cutover.
  "routes": [
    { "pattern": "trydos.ramaaz.dev/api/proxy", "zone_name": "ramaaz.dev" },
    { "pattern": "trydos.ramaaz.dev/api/proxy-edge", "zone_name": "ramaaz.dev" }
  ]

  // Backend base URLs are secrets, set with `wrangler secret put`:
  //   BACKEND_URL, GO_BACKEND_URL, ELASTIC_BACKEND_URL,
  //   NEXT_PUBLIC_CHAT_BACKEND_URL, STORIES_BACKEND_URL,
  //   COMMENT_BACKEND_URL, WALLET_BACKEND_URL
  // Never commit their values — see CLAUDE.md §3.9.
}
