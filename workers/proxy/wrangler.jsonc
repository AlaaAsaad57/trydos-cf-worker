{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trydos-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Bound to the SAME hostname the app serves from — the auth cookies are
  // host-only, so a sibling subdomain would not receive MARKET-TOKEN.
  //
  // SHADOW PATH ON PURPOSE. /api/proxy-edge is not served by Vercel, so this
  // Worker owns it outright and the live /api/proxy is untouched. Compare the
  // two with real cookies before changing this to /api/proxy — a big-bang
  // cutover would put every authenticated request through untested code with
  // route deletion as the only rollback.
  "routes": [
    { "pattern": "trydos.ramaaz.dev/api/proxy-edge", "zone_name": "ramaaz.dev" }
  ]

  // Backend base URLs are secrets, set with `wrangler secret put`:
  //   BACKEND_URL, GO_BACKEND_URL, ELASTIC_BACKEND_URL,
  //   NEXT_PUBLIC_CHAT_BACKEND_URL, STORIES_BACKEND_URL,
  //   COMMENT_BACKEND_URL, WALLET_BACKEND_URL
  // Never commit their values — see CLAUDE.md §3.9.
}
